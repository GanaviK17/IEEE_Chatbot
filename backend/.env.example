# ====================================================================
# NVIDIA Hosted Inference API Configuration
# Get your free developer API key from https://build.nvidia.com/
# ====================================================================
NVIDIA_API_KEY=YOUR_NVIDIA_API_KEY_HERE
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Officially supported Nemotron models:
# - nvidia/llama-3.1-nemotron-70b-instruct
# - nvidia/nemotron-4-340b-instruct
# - nvidia/nemotron-mini-4b-instruct
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# Server settings
PORT=8000
HOST=0.0.0.0

# ====================================================================
# Admin Authentication Settings
# Default credentials: username = admin, password = admin123
# Change in production by generating a new bcrypt hash:
# python -c "import bcrypt; print(bcrypt.hashpw(b'YOUR_PASSWORD', bcrypt.gensalt()).decode())"
# ====================================================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2b$12$iSzMnkeJBEd3vZsNfYeL7uxqK6XOLkYlg4DC46D3uWWAnM2.5sHjm
JWT_SECRET_KEY=ieee-assistant-secure-jwt-secret-key-2026
